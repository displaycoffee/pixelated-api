{
	"name": "pixelated-api",
	"displayName": "Pixelated API",
	"description": "API for 'Pixelated' guessing game.",
	"version": "1.0.0",
	"main": "dist/index.js",
	"type": "module",
	"keywords": [],
	"author": "displaycoffee",
	"license": "ISC",
	"homepage": "https://pixelated-api.display.coffee",
	"scripts": {
		"build": "esbuild src/index.ts --bundle --platform=node --target=node20 --outfile=dist/index.js --format=esm --packages=external",
		"dev": "tsx watch src/index.ts",
		"format": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\"",
		"start": "node dist/index.js"
	},
	"devDependencies": {
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/node": "^26.5.1",
		"esbuild": "^0.28.2",
		"nodemon": "^3.1.14",
		"prettier": "^3.9.6",
		"ts-node": "^10.9.2",
		"tsx": "^4.23.13",
		"typescript": "^6.0.3"
	},
	"dependencies": {
		"cors": "^2.8.6",
		"dotenv": "^17.4.2",
		"express": "^5.2.1",
		"mysql2": "^3.24.4"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/displaycoffee/pixelated-api.git"
	},
	"bugs": {
		"url": "https://github.com/displaycoffee/pixelated-api/issues"
	}
}
